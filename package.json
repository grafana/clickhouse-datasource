{
  "name": "clickhouse-datasource",
  "version": "4.21.2",
  "description": "Clickhouse Datasource",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e:report": "npx playwright show-report",
    "e2e:ui": "npx playwright test --ui",
    "e2e": "playwright test",
    "gen-dashboards": "node ./gen-db-dashboards",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "lint": "eslint --cache .",
    "prettier:check": "npx prettier --check --ignore-path .prettierignore --list-different=false --log-level=warn \"**/*.{ts,tsx,scss,md,mdx,json,js,cjs}\"",
    "prettier:write": "npx prettier --ignore-path .prettierignore --list-different \"**/*.{js,ts,tsx,scss,md,mdx,json,cjs}\" --write",
    "server": "docker compose up --build",
    "sign": "npx --package=@grafana/sign-plugin@3.2.2 -- sign-plugin",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test": "jest --watch --onlyChanged",
    "typecheck": "tsc --noEmit"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.1",
    "@grafana/eslint-config": "8.2.0",
    "@grafana/plugin-e2e": "3.11.1",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/glob": "8.1.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-livereload-plugin": "2.3.6",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.2.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.9.6",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.103.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "overrides": {
    "rxjs": "^7.5.6",
    "picomatch": "4.0.7",
    "minimatch@3.x": "3.1.5",
    "minimatch@10.x": "10.2.5",
    "brace-expansion@5.x": "5.0.7",
    "ajv@8.x": "8.18.0",
    "react-router": "6.30.4",
    "react-router-dom-v5-compat": "6.30.6",
    "@remix-run/router": "1.23.4",
    "immutable": "5.1.9"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.2.1",
    "@grafana/runtime": "13.2.1",
    "@grafana/schema": "13.2.1",
    "@grafana/ui": "13.2.1",
    "@openfeature/web-sdk": "1.9.0",
    "pgsql-ast-parser": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql-formatter": "15.8.2",
    "tslib": "2.8.1"
  },
  "packageManager": "npm@11.19.1"
}
